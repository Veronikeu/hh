@page
@using Практика.Models
@model Практика.Pages.Users.IndexModel
@{
    ViewData["Title"] = "Пользователи";
}

<div class="page-head">
    <div>
        <h1>Пользователи системы</h1>
        <p class="hint">Раздел доступен только администратору.</p>
    </div>
</div>

<div class="card card--pink">
    <h2>Добавить пользователя</h2>
    <form method="post" asp-page-handler="Create">
        <div class="form-grid">
            <div class="field">
                <label for="fio">ФИО *</label>
                <input id="fio" name="fio" required placeholder="Иванова Мария Петровна" />
            </div>
            <div class="field">
                <label for="login">Логин *</label>
                <input id="login" name="login" required placeholder="m.ivanova" />
            </div>
            <div class="field">
                <label for="phone">Телефон *</label>
                <input id="phone" name="phone" type="tel" required placeholder="+7 900 123-45-67" />
            </div>
            <div class="field">
                <label for="email">Email *</label>
                <input id="email" name="email" type="email" required placeholder="ivanova@company.ru" />
            </div>
            <div class="field">
                <label for="password">Пароль *</label>
                <input id="password" name="password" type="password" required placeholder="буквы и цифры, от 6 символов" />
            </div>
            <div class="field">
                <label for="role">Роль</label>
                <select id="role" name="role">
                    <option value="@Roles.Manager">Менеджер по подбору</option>
                    <option value="@Roles.Admin">Администратор</option>
                </select>
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn--primary">Создать пользователя</button>
        </div>
    </form>
</div>

<div class="table-wrap">
    <table>
        <thead>
            <tr>
                <th>ФИО</th>
                <th>Логин</th>
                <th>Email</th>
                <th>Роль</th>
                <th>Дата регистрации</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model.Items)
            {
                <tr>
                    <td>
                        <b>@user.Fio</b>
                        @if (user.Id == Model.CurrentUserId)
                        {
                            <div class="hint">это вы</div>
                        }
                    </td>
                    <td>@user.Login</td>
                    <td>@user.Email</td>
                    <td>
                        <form method="post" asp-page-handler="ChangeRole" asp-route-id="@user.Id" class="table-actions">
                            <select name="role">
                                <option value="@Roles.Manager" selected="@(user.Role == Roles.Manager)">Менеджер по подбору</option>
                                <option value="@Roles.Admin" selected="@(user.Role == Roles.Admin)">Администратор</option>
                            </select>
                            <button type="submit" class="btn btn--small">Применить</button>
                        </form>
                    </td>
                    <td>@user.CreatedAt.ToString("dd.MM.yyyy")</td>
                    <td>
                        <div class="table-actions">
                            <form method="post" asp-page-handler="Delete" asp-route-id="@user.Id"
                                  data-confirm="Удалить учётную запись «@user.Fio»?">
                                <button type="submit" class="btn btn--small btn--danger">Удалить</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
