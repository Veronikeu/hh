@page
@using Практика.Models
@model Практика.Pages.Candidates.IndexModel
@{
    ViewData["Title"] = "Кандидаты";
}

<div class="page-head">
    <div>
        <h1>Кандидаты</h1>
    </div>
    <a class="btn btn--primary" asp-page="/Candidates/Edit">Добавить кандидата</a>
</div>

<form method="get" class="card card--green">
    <h2>Поиск кандидатов</h2>

    <div class="form-grid">
        <div class="field">
            <label asp-for="Fio">ФИО</label>
            <input asp-for="Fio" type="search" placeholder="часть фамилии или имени" />
        </div>

        <div class="field">
            <label asp-for="City">Город</label>
            <select asp-for="City">
                <option value="">— любой —</option>
                @foreach (var city in Model.Cities)
                {
                    <option value="@city">@city</option>
                }
            </select>
        </div>

        <div class="field">
            <label asp-for="Gender">Пол</label>
            <select asp-for="Gender">
                <option value="">— любой —</option>
                @foreach (var gender in Reference.Genders)
                {
                    <option value="@gender">@gender</option>
                }
            </select>
        </div>

        <div class="field">
            <label asp-for="AgeMin">Возраст, от</label>
            <input asp-for="AgeMin" type="number" min="14" max="100" placeholder="например, 20" />
        </div>

        <div class="field">
            <label asp-for="AgeMax">Возраст, до</label>
            <input asp-for="AgeMax" type="number" min="14" max="100" placeholder="например, 45" />
        </div>

        <div class="field">
            <label asp-for="SalaryMin">Зарплата, от</label>
            <input asp-for="SalaryMin" type="number" min="0" step="1000" placeholder="₽" />
        </div>

        <div class="field">
            <label asp-for="SalaryMax">Зарплата, до</label>
            <input asp-for="SalaryMax" type="number" min="0" step="1000" placeholder="₽" />
        </div>

        <div class="field">
            <label asp-for="Experience">Опыт работы</label>
            <select asp-for="Experience">
                <option value="">— любой —</option>
                @foreach (var item in Reference.Experiences)
                {
                    <option value="@item">@item</option>
                }
            </select>
        </div>

        <div class="field">
            <label asp-for="WorkFormat">Формат работы</label>
            <select asp-for="WorkFormat">
                <option value="">— любой —</option>
                @foreach (var item in Reference.WorkFormats)
                {
                    <option value="@item">@item</option>
                }
            </select>
        </div>

        <div class="field">
            <label asp-for="Language">Иностранный язык</label>
            <select asp-for="Language">
                <option value="">— любой —</option>
                @foreach (var item in Reference.Languages)
                {
                    <option value="@item">@item</option>
                }
            </select>
        </div>

        <div class="field">
            <label asp-for="PcLevel">Уровень владения ПК</label>
            <select asp-for="PcLevel">
                <option value="">— любой —</option>
                @foreach (var item in Reference.PcLevels)
                {
                    <option value="@item">@item</option>
                }
            </select>
        </div>

        <div class="field">
            <label asp-for="TeamManagement">Опыт управления командой</label>
            <select asp-for="TeamManagement">
                <option value="">— не важно —</option>
                @foreach (var item in Reference.YesNo)
                {
                    <option value="@item">@item</option>
                }
            </select>
        </div>

        <div class="field">
            <label asp-for="Education">Образование</label>
            <input asp-for="Education" type="search" placeholder="вуз, специальность или уровень" />
        </div>
    </div>

    <div class="field" style="margin-top:14px">
        <label>Навыки (кандидат должен обладать всеми отмеченными)</label>
        <div class="checkbox-list">
            @foreach (var skill in Model.AllSkills)
            {
                <label>
                    <input type="checkbox" name="SkillIds" value="@skill.Id"
                           checked="@Model.SkillIds.Contains(skill.Id)" />
                    @skill.Name
                </label>
            }
        </div>
    </div>

    <input type="hidden" asp-for="Sort" />
    <input type="hidden" asp-for="Dir" />

    <div class="form-actions">
        <button type="submit" class="btn btn--primary">Найти</button>
        <a class="btn" asp-page="/Candidates/Index">Сбросить фильтры</a>
    </div>
</form>

<div class="table-wrap">
    <table>
        <thead>
            <tr>
                <th>
                    <a href='@Model.SortUrl("fio")'>ФИО</a>
                </th>
                <th>
                    <a href='@Model.SortUrl("age")'>Возраст</a>
                </th>
                <th>Пол</th>
                <th>
                    <a href='@Model.SortUrl("city")'>Город</a>
                </th>
                <th>
                    <a href='@Model.SortUrl("experience")'>Опыт</a>
                </th>
                <th>Формат</th>
                <th>
                    <a href='@Model.SortUrl("salary")'>Зарплата</a>
                </th>
                <th>Навыки</th>
                <th>Контакты</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Items.Count == 0)
            {
                <tr>
                    <td colspan="10">
                        <div class="empty">
                            По заданным условиям кандидаты не найдены.<br />
                            Измените параметры поиска или нажмите «Сбросить фильтры».
                        </div>
                    </td>
                </tr>
            }
            else
            {
                @foreach (var candidate in Model.Items)
                {
                    <tr>
                        <td>
                            <b>@candidate.Fio</b>
                            @if (candidate.Educations.Count > 0)
                            {
                                var education = candidate.Educations.First();
                                <div class="hint">@education.Specialty, @education.Institution</div>
                            }
                        </td>
                        <td>@(candidate.Age?.ToString() ?? "—")</td>
                        <td>@(candidate.Gender ?? "—")</td>
                        <td>@(candidate.City ?? "—")</td>
                        <td>@(candidate.Experience ?? "—")</td>
                        <td>@(candidate.WorkFormat ?? "—")</td>
                        <td>@(candidate.Salary.HasValue ? $"{candidate.Salary:N0} ₽" : "—")</td>
                        <td>
                            @foreach (var link in candidate.CandidateSkills)
                            {
                                <span class="tag">@link.Skill?.Name</span>
                            }
                        </td>
                        <td>
                            @candidate.Phone
                            <div class="hint">@candidate.Email</div>
                        </td>
                        <td>
                            <div class="table-actions">
                                <a class="btn btn--small" asp-page="/Candidates/Edit" asp-route-id="@candidate.Id">Изменить</a>
                                @if (Model.IsAdmin)
                                {
                                    <form method="post" asp-page-handler="Delete" asp-route-id="@candidate.Id"
                                          data-confirm="Удалить кандидата «@candidate.Fio»? Отменить это действие будет нельзя.">
                                        <button type="submit" class="btn btn--small btn--danger">Удалить</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
