@page
@using Практика.Models
@model Практика.Pages.Vacancies.IndexModel
@{
    ViewData["Title"] = "Вакансии";
}

<div class="page-head">
    <div>
        <h1>Вакансии</h1>
    </div>
    <a class="btn btn--primary" asp-page="/Vacancies/Edit">Добавить вакансию</a>
</div>

<form method="get" class="card card--yellow">
    <div class="form-grid">
        <div class="field">
            <label asp-for="Title">Название вакансии</label>
            <input asp-for="Title" type="search" placeholder="например, разработчик" />
        </div>

        <div class="field">
            <label asp-for="CompanyId">Компания</label>
            <select asp-for="CompanyId">
                <option value="">— любая —</option>
                @foreach (var company in Model.Companies)
                {
                    <option value="@company.Id">@company.Name</option>
                }
            </select>
        </div>

        <div class="field">
            <label asp-for="WorkFormat">Формат работы</label>
            <select asp-for="WorkFormat">
                <option value="">— любой —</option>
                @foreach (var item in Reference.WorkFormats)
                {
                    <option value="@item">@item</option>
                }
            </select>
        </div>

        <div class="field">
            <label asp-for="Status">Статус</label>
            <select asp-for="Status">
                <option value="">— любой —</option>
                @foreach (var item in Reference.VacancyStatuses)
                {
                    <option value="@item.Key">@item.Value</option>
                }
            </select>
        </div>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn--primary">Найти</button>
        <a class="btn" asp-page="/Vacancies/Index">Сбросить фильтры</a>
    </div>
</form>

<div class="table-wrap">
    <table>
        <thead>
            <tr>
                <th>Вакансия</th>
                <th>Компания</th>
                <th>Зарплата</th>
                <th>Формат</th>
                <th>Требуемый опыт</th>
                <th>Возраст</th>
                <th>Требуемые навыки</th>
                <th>Статус</th>
                <th>Отклики</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Items.Count == 0)
            {
                <tr>
                    <td colspan="10">
                        <div class="empty">Вакансии по заданным условиям не найдены.</div>
                    </td>
                </tr>
            }
            else
            {
                @foreach (var vacancy in Model.Items)
                {
                    <tr>
                        <td>
                            <b>@vacancy.Title</b>
                            @if (!string.IsNullOrWhiteSpace(vacancy.Description))
                            {
                                <div class="hint">@vacancy.Description</div>
                            }
                        </td>
                        <td>@vacancy.Company?.Name</td>
                        <td>@vacancy.SalaryText</td>
                        <td>@(vacancy.WorkFormat ?? "—")</td>
                        <td>@(vacancy.RequiredExperience ?? "—")</td>
                        <td>
                            @if (vacancy.RequiredAgeMin.HasValue || vacancy.RequiredAgeMax.HasValue)
                            {
                                @($"{vacancy.RequiredAgeMin?.ToString() ?? "—"} – {vacancy.RequiredAgeMax?.ToString() ?? "—"}")
                            }
                            else
                            {
                                @("—")
                            }
                        </td>
                        <td>
                            @foreach (var link in vacancy.VacancySkills)
                            {
                                <span class="tag">@link.Skill?.Name</span>
                            }
                        </td>
                        <td>
                            <span class="status @(vacancy.Status == "active" ? "status--accepted" : "status--rejected")">
                                @vacancy.StatusName
                            </span>
                        </td>
                        <td>@(Model.ApplicationCounts.TryGetValue(vacancy.Id, out var count) ? count : 0)</td>
                        <td>
                            <div class="table-actions">
                                <a class="btn btn--small btn--accent" asp-page="/Vacancies/Match" asp-route-id="@vacancy.Id">Подобрать кандидатов</a>
                                <a class="btn btn--small" asp-page="/Vacancies/Edit" asp-route-id="@vacancy.Id">Изменить</a>
                                @if (Model.IsAdmin)
                                {
                                    <form method="post" asp-page-handler="Delete" asp-route-id="@vacancy.Id"
                                          data-confirm="Удалить вакансию «@vacancy.Title»? Вместе с ней будут удалены все отклики на неё.">
                                        <button type="submit" class="btn btn--small btn--danger">Удалить</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
